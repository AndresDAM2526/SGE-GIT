<odoo>
    <data>
        <record model="ir.ui.view" id="vista_tallerandres_marca_tree">
            <field name="name">vista_tallerandres_marca_tree</field>
            <field name="model">tallerandres.marca</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>

                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_tallerandres_marca_form">
            <field name="name">vista_tallerandres_marca_form</field>
            <field name="model">tallerandres.marca</field>
            <field name="arch" type="xml">
                <form string="formulario_marca">
                    <sheet>
                        <group name="group_top">
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="accion_tallerandres_marca_form">
            <field name="name">Marca</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tallerandres.marca</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Marca
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>

        <menuitem name="Marca" id="menu_tallerandres_marca" parent="menu_tallerandres"
              action="accion_tallerandres_marca_form"/>

    </data>
</odoo>