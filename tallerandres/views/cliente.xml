<odoo>
    <data>
        <record model="ir.ui.view" id="tallerandres.cliente_partner_form">
            <field name="name">tallerandres cliente form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"></field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
                    <page name="vehiculo" string="Vehiculos">
                        <group>
                            <group>
                                <field name="id_vehiculo"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="tallerandres.action_cliente_window">
            <field name="name">Clientes</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window.view" id="tallerandres.action_view_cliente_tree">
            <field name="sequence" eval="1"></field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="base.view_partner_tree"></field>
            <field name="act_window_id" ref="tallerandres.action_cliente_window"></field>
        </record>


        <record model="ir.actions.act_window.view" id="tallerandres.action_view_cliente_form">
            <field name="sequence" eval="2"></field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="tallerandres.cliente_partner_form"></field>
            <field name="act_window_id" ref="tallerandres.action_cliente_window"></field>
        </record>


        <!--Menú raíz-->
        <menuitem name="TallerAndres" id="menu_tallerandres_raiz"/>
        <!--Segundo nivel-->
        <menuitem name="Taller" id="menu_tallerandres" parent="menu_tallerandres_raiz"/>

        <menuitem name="Cliente" id="menu_tallerandres_cliente" parent="menu_tallerandres"
              action="tallerandres.action_cliente_window"/>
    </data>
</odoo>