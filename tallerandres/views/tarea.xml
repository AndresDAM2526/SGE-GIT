<odoo>
    <data>
        <record model="ir.ui.view" id="vista_tallerandres_tarea_tree">
            <field name="name">vista_tallerandres_tarea_tree</field>
            <field name="model">tallerandres.tarea</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="tiempo"/>
                    <field name="precio_hora"/>
                    <field name="total"/>
                    <field name="id_reparacion"/>
                    <field name="id_mecanico"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_tallerandres_tarea_form">
            <field name="name">vista_tallerandres_tarea_form</field>
            <field name="model">tallerandres.tarea</field>
            <field name="arch" type="xml">
                <form string="formulario_tarea">
                    <sheet>
                        <group name="group_top">
                            <field name="name"/>
                            <field name="tiempo"/>
                            <field name="precio_hora"/>
                            <field name="total"/>
                            <field name="id_reparacion"/>
                            <field name="id_mecanico"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="accion_tallerandres_tarea_form">
            <field name="name">Tarea</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tallerandres.tarea</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Tarea
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>
        
        <menuitem name="Tarea" id="menu_tallerandres_tarea" parent="menu_tallerandres"
              action="accion_tallerandres_tarea_form"/>

    </data>
</odoo>