<odoo>
    <data>
        <record model="ir.ui.view" id="vista_tallerandres_vehiculo_tree">
            <field name="name">vista_tallerandres_vehiculo_tree</field>
            <field name="model">tallerandres.vehiculo</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="matricula"/>
                    <field name="modelo"/>
                    <field name="id_cliente"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_tallerandres_vehiculo_form">
            <field name="name">vista_tallerandres_vehiculo_form</field>
            <field name="model">tallerandres.vehiculo</field>
            <field name="arch" type="xml">
                <form string="formulario_vehiculo">
                    <sheet>
                        <group name="group_top">
                    <field name="matricula"/>
                    <field name="modelo"/>
                    <field name="id_cliente"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record model="ir.actions.act_window" id="accion_tallerandres_vehiculo_form">
            <field name="name">vehiculo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tallerandres.vehiculo</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    vehiculo
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>

        <menuitem name="Vehiculo" id="menu_tallerandres_vehiculo" parent="menu_tallerandres"
action="accion_tallerandres_vehiculo_form"/>

    </data>
</odoo>