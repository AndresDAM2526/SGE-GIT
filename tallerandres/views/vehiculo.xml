<odoo>
    <data>
        <record model="ir.ui.view" id="vista_tallerandres_vehiculo_tree">
            <field name="name">vista_tallerandres_vehiculo_tree</field>
            <field name="model">tallerandres.vehiculo</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="id_marca"/>
                    <field name="modelo"/>
                    <field name="id_cliente"/>
                    <field name="foto"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_tallerandres_vehiculo_form">
            <field name="name">vista_tallerandres_vehiculo_form</field>
            <field name="model">tallerandres.vehiculo</field>
            <field name="arch" type="xml">
                <form string="formulario_vehiculo">
                    <sheet>
                        <group name="group_top">
                            <field name="name"/>
                            <field name="id_marca"/>
                            <field name="modelo"/>
                            <field name="id_cliente"/>
                            <field name="foto"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record model="ir.actions.act_window" id="accion_tallerandres_vehiculo_form">
            <field name="name">Vehiculo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tallerandres.vehiculo</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    vehiculo
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_tallerandres_vehiculo_kanban">
            <field name="name">vista_tallerandres_vehiculo_kanban</field>
            <field name="model">tallerandres.vehiculo</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="id_marca"/>
                    <field name="modelo"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img alt="cartel" t-att-src="kanban_image('tallerandres.vehiculo','foto',record.id.raw_value)"/>
                                </div>
                                <div class="o_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="id_marca"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="modelo"/>
                                    </strong>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        

        <menuitem name="Vehiculo" id="menu_tallerandres_vehiculo" parent="menu_tallerandres"
action="accion_tallerandres_vehiculo_form"/>

    </data>
</odoo>