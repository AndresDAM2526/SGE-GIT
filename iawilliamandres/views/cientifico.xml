<odoo>
  <data>
  <record model="ir.ui.view" id="manageandres.devs_partner_form">
            <field name="name">manageandres devs form</field>
            <field name="model">iawilliamandres.cientifico</field>
            <field name="inherit_id" ref="base.view_partner_form"></field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
                    <page name="Recursos usados" string="Recursos">
                        <group>
                            <group>

                            </group>
                        </group>
                    </page>
                    <page name="Proyectos" string="Proyectos">
                        <group>
                            <group>
                             
                                <field name="proyectos_id"></field>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

  <record model="ir.ui.view" id="vista_iawilliamandres_cientifico_tree">
            <field name="name">vista_iawilliamandres_task_tree</field>
            <field name="model">iawilliamandres.cientifico</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nombre"/>
                    <field name="proyectos_id"/>
                    <field name="especialidades_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_iawilliamandres_cientifico_form">
                <field name="name">vista_iawilliamandres_cientifico_form</field>
                <field name="model">iawilliamandres.cientifico</field>
                <field name="arch" type="xml">
                    <form string="formulario_task">
                        <sheet>
                            <group name="group_top">
                                <field name="nombre"/>
                                <field name="especialidades_id"/>
                                <field name="proyectos_id"/>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>
   
        <record model="ir.actions.act_window" id="accion_iawilliamandres_cientifico_form">
            <field name="name">cientifico</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">iawilliamandres.cientifico</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Cientifico
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>

       
        
        <menuitem name="IA" id="menu_iawilliamandres" parent="menu_iawilliamandres_raiz"/>
        <menuitem name="Cientifico" id="menu_iawilliamandres_cientifico" parent="menu_iawilliamandres"
              action="accion_iawilliamandres_cientifico_form"/>
  </data>
</odoo>