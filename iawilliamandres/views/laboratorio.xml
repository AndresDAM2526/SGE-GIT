<odoo>
  <data>

  <record model="ir.ui.view" id="vista_iawilliamandres_laboratorio_tree">
            <field name="name">vista_manageandres_task_tree</field>
            <field name="model">iawilliamandres.laboratorio</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nombre"/>
                    <field name="pais"/>
                    <field name="tipo"/>
                    <field name="proyectos_id"/>

                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_iawilliamandres_laboratorio_form">
                <field name="name">vista_iawilliamandres_laboratorio_form</field>
                <field name="model">iawilliamandres.laboratorio</field>
                <field name="arch" type="xml">
                    <form string="formulario_task">
                        <sheet>
                            <group name="group_top">
                                <field name="nombre"/>
                                <field name="pais"/>
                                <field name="tipo"/>
                                <field name="proyectos_id"/>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>
   
        <record model="ir.actions.act_window" id="accion_iawilliamandres_laboratorio_form">
            <field name="name">Laboratorio</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">iawilliamandres.laboratorio</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Laboratorio
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>

        <menuitem name="IAWilliamAndres" id="menu_iawilliamandres_raiz"/>
         <!--Segundo nivel-->
        <menuitem name="IA" id="menu_iawilliamandres" parent="menu_iawilliamandres_raiz"/>

        <menuitem name="Laboratorio" id="menu_iawilliamandres_laboratorio" parent="menu_iawilliamandres"
              action="accion_iawilliamandres_laboratorio_form"/>
  </data>
</odoo>