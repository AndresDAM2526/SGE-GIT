<odoo>
    <data>
    
        <record model="ir.ui.view" id="vista_manageandres_technology_tree">
            <field name="name">vista_manageandres_technology_tree</field>
            <field name="model">manageandres.technology</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="photo"/>
                    <field name="tasks_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_manageandres_technology_form">
                <field name="name">vista_manageandres_technology_form</field>
                <field name="model">manageandres.technology</field>
                <field name="arch" type="xml">
                    <form string="formulario_technology">
                        <sheet>
                            <group name="group_top">
                                <field name="name"/>
                                <field name="description"/>
                                <field name="photo"/>
                                <field name="tasks_id"/>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>

        <record model="ir.actions.act_window" id="accion_manageandres_technology_form">
            <field name="name">Technology</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">manageandres.technology</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    technology
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>




        <!--Menu raíz-->
        <menuitem name="ManagementAndres" id="menu_manageandres_raiz"/>
        
        <menuitem name="Technology" id="menu_manageandres_technology" parent="menu_manageandres"
              action="accion_manageandres_technology_form"/>
    </data>
</odoo>