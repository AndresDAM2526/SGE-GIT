<odoo>
    <data>
        <record model="ir.ui.view" id="vista_manageandres_history_tree">
            <field name="name">vista_manageandres_history_tree</field>
            <field name="model">manageandres.history</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="project_id"/>
                    <field name="tasks_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="vista_manageandres_history_form">
                <field name="name">vista_manageandres_history_form</field>
                <field name="model">manageandres.history</field>
                <field name="arch" type="xml">
                    <form string="formulario_history">
                        <sheet>
                            <group name="group_top">
                                <field name="name"/>
                                <field name="description"/>
                                <field name="project_id"/>
                                <field name="tasks_id"/>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>

        <record model="ir.actions.act_window" id="accion_manageandres_history_form">
            <field name="name">History</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">manageandres.history</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    History
                </p>
                <p>Click <strong>Crear</strong> para añadir nuevo elementos
                </p>
            </field>
        </record>

        <!--Menu raíz-->
        <menuitem name="ManagementAndres" id="menu_manageandres_raiz"/>

        <menuitem name="History" id="menu_manageandres_history" parent="menu_manageandres"
              action="accion_manageandres_history_form"/>
    </data>
</odoo>